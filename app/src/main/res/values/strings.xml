    <string name="developer_credit">Developed by Sujan Rai of the Blind Tech Nexus team.</string>

    <string name="welcome_title">Accessible Camera and Gallery</string>
    <string name="welcome_description">An accessible, open-source camera and gallery app for Android. Take photos, record video, and manage your media with full screen reader support and voice guidance.</string>
    <string name="welcome_permission_heading">What this app uses</string>
    <string name="welcome_permission_camera">Camera: to show the viewfinder and take photos or record video.</string>
    <string name="welcome_permission_microphone">Microphone: only while you record video with sound turned on.</string>
    <string name="welcome_permission_media">Photos and videos: to show your gallery and open your captures.</string>
    <string name="welcome_permission_location">Location: optional, only if you turn on location tagging in Settings.</string>
    <string name="welcome_privacy">Everything stays on your device. There is no analytics and no network access without your consent.</string>
    <string name="welcome_start">Start</string>
    <string name="welcome_settings_hint">You can change voice guidance and accessibility options at any time in the Settings tab.</string>

